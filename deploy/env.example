# deploy/env.example -- every variable pickvedio-core reads.
#
# Copy it, fill the two secrets, and it works for all four runtimes:
#   cp deploy/env.example .env            # docker compose loads .env for ${VAR}
#   docker compose -f deploy/compose.yaml --env-file deploy/env.example up
#   export $(grep -v '^#' deploy/env.example | xargs)   # bare uvicorn / pvc
# Railway / Render / Fly: paste the NON-EMPTY lines into their variables UI, and
# put the SECRET lines in the private-secret store (`fly secrets set`,
# Render "Environment -> Secret Env", Railway private vars). Never commit the
# filled-in copy.
#
# Meaning + default come from src/pickvedio_core/config.py; the defaults shown
# are what the code uses when the variable is unset or empty. The values below
# are the RELAY-FIRST production profile from
# skills/video-summary/references/deploy-runbook.md, i.e. transcription arrives
# from a logged-in browser via POST /v1/transcripts and this service only
# chunks + summarises. Nothing here enables downloading or ASR by default.
#
# Secret hygiene: never echo a value into a chat transcript or a build log;
# `pvc status` prints variable NAMES and booleans only.

# ===========================================================================
# 1. Inbound auth -- guards every /v1/* route (Authorization: Bearer <value>)
# ===========================================================================
# SECRET. Generate: python3 -c "import secrets; print(secrets.token_hex(24))".
# Unset = /v1/* refuses to serve (deliberate: an open summariser burns your LLM
# budget). /healthz and /openapi.json stay open so health checks work.
PVC_API_TOKEN=
# Alias accepted by config.py: PVC_AUTH_TOKEN.
# PVC_AUTH_TOKEN=

# The URL of the deployed service. CLIENT-SIDE only -- the `pvc` CLI uses it, the
# service ignores it. Needed for `pvc status --service`, `pvc push`, `pvc job`.
PVC_SERVICE_URL=

# ===========================================================================
# 2. Summariser (LLM) -- the only channel the default deployment needs
# ===========================================================================
# deepseek|openai|moonshot|zhipu|qwen|siliconflow|localai. Default when unset:
# deepseek. A preset alone supplies base_url + model, so PVC_LLM_PROVIDER plus
# the key is the minimum working pair.
PVC_LLM_PROVIDER=deepseek
# Override the preset endpoint. Default: the preset's base_url.
PVC_LLM_BASE_URL=
# SECRET, unless the base_url points at localhost/127.0.0.1 (localai/Ollama-style
# needs no key). Accepted aliases: PVC_API_KEY, DEEPSEEK_API_KEY, OPENAI_API_KEY.
PVC_LLM_API_KEY=
# Override the preset model name. Default: preset model
# (deepseek -> deepseek-chat, openai -> gpt-4o-mini, ...).
PVC_LLM_MODEL=
# Summary creativity/stability. Default 0.2. Keep it low: this is evidence work.
PVC_LLM_TEMPERATURE=0.2
# Max tokens per summariser call. Default 2600. Raise only with a reason --
# it multiplies cost on chunked long videos.
PVC_LLM_MAX_TOKENS=2600
# Per-request LLM timeout in seconds. Default 300. (alias PVC_LLM_TIMEOUT)
PVC_LLM_TIMEOUT=300

# ===========================================================================
# 3. Ollama (optional local summariser channel)
# ===========================================================================
# Default http://127.0.0.1:11434. Pointless on a hosted service unless Ollama
# runs next to it.
PVC_OLLAMA_URL=
# Empty = Ollama channel disabled (the default). Set a model name to enable it.
PVC_OLLAMA_MODEL=
# 1 = ask Ollama to emit its thinking block. Default 0.
PVC_OLLAMA_THINK=0

# ===========================================================================
# 4. ASR (speech-to-text) -- OFF by default, and it costs money or CPU
# ===========================================================================
# EMPTY = ASR disabled: videos with no subtitles simply fail with a precise
# message instead of a surprise bill. openai|groq|local_server|faster_whisper.
# Only turn this on after the user approves it; it also needs the media path
# (yt-dlp + ffmpeg, i.e. --build-arg INCLUDE_FFMPEG=1) for everything except
# faster_whisper, which decodes audio itself.
PVC_ASR_PROVIDER=
# Override the preset endpoint. Presets: openai -> https://api.openai.com/v1,
# groq -> https://api.groq.com/openai/v1, local_server -> http://127.0.0.1:8000/v1
# (in compose that becomes http://asr:8000/v1).
PVC_ASR_BASE_URL=
# SECRET. If empty, config.py falls back to PVC_LLM_API_KEY -- convenient, but
# it silently uses the summariser account for transcription, so set it
# explicitly when the ASR provider differs from the LLM provider.
PVC_ASR_API_KEY=
# Preset models: openai -> whisper-1, groq -> whisper-large-v3-turbo,
# local_server -> whisper-1, faster_whisper -> small.
PVC_ASR_MODEL=
# Hard ceiling on how many minutes of audio may be transcribed per job.
# Default 180. This is the main money guard: set it before enabling ASR.
PVC_ASR_MAX_MINUTES=180
# Per-request ASR timeout in seconds. Default 600. (alias PVC_ASR_TIMEOUT)
PVC_ASR_TIMEOUT=600
# Force the transcription language (e.g. zh, ja, en). Empty = auto-detect.
PVC_ASR_LANGUAGE=
# Seconds of audio per ASR request chunk. Default 600.
PVC_ASR_CHUNK_SECONDS=600
# Per-platform cookies: a Bilibili cookie does nothing for YouTube and vice
# versa. Both fall back to PVC_COOKIE_FILE when unset.
# PVC_YOUTUBE_COOKIE_FILE=/run/secrets/youtube-cookies.txt
# 1 = voice-activity-detection trimming of silence. Default 1.
PVC_ASR_VAD=1
# Whisper beam size for local faster_whisper. Default 5 (higher = slower).
PVC_WHISPER_BEAM_SIZE=5

# ===========================================================================
# 5. Workdir, media and platform access
# ===========================================================================
# Where job state, transcripts, chunk summaries and reports are written.
# Default ./pickvedio-work ; /data in the container. On ephemeral free tiers this
# directory is lost on redeploy, so mount a volume or re-run the job.
PVC_WORKDIR=/data
# 1 = keep downloaded audio after a job. Default 0 (delete): free tiers bill and
# fill storage by the megabyte.
PVC_KEEP_MEDIA=0
# Path to a Netscape-format cookie file, the user's OWN session, for the direct
# fetch path. Default empty. Prefer the browser relay over copying cookies.
PVC_COOKIE_FILE=
# Alias: PVC_COOKIES.
# Bilibili SESSDATA for the same purpose. SECRET -- a login cookie for the
# user's account. Default empty; shipping it to a public host is a worse idea
# than using the logged-in browser relay.
PVC_BILIBILI_SESSDATA=
# ffmpeg binary for the ASR audio-cut path. Default: whatever is on PATH; the
# default image has none (build with INCLUDE_FFMPEG=1). Set an absolute path for
# a non-standard install.
PVC_FFMPEG=
# 1 = accept URLs from platforms this build does not know. Default 0: unknown
# platforms should be an explicit decision, not a silent guess.
PVC_ALLOW_UNKNOWN_PLATFORM=0

# ===========================================================================
# 6. Cost / length shape of a summary
# ===========================================================================
# Characters of transcript per summariser chunk. Default 18000; the runbook uses
# 9000 on a hosted free tier because more chunks = more tokens = more money.
PVC_CHUNK_CHARS=9000
# Maximum chunks per job. Default 40. Beyond this the job fails rather than
# silently truncating a 6-hour video.
PVC_MAX_CHUNKS=40
# Refuse to summarise anything longer than this many minutes. Default 300.
PVC_MAX_MINUTES=180
# Default summary profile: general|interview|tutorial|brief.
# Note: if PVC_STYLE is unset the code's load() falls back to "notes", which is
# a legacy desktop name -- so set it explicitly, as here.
PVC_STYLE=general
# Directory holding `<profile>_<slot>.md` prompt overrides (chunk/final/chat).
# Empty = the built-in templates in pickvedio_core.prompts are used, which are
# byte-identical to the desktop app. Point it at the repo's prompts/ to override.
PVC_PROMPT_DIR=
# Optional JSON seed file (legacy desktop settings) read BEFORE the environment.
# Default ~/.pickvedio/settings.json, which does not exist in a container.
PVC_CONFIG_FILE=

# ===========================================================================
# 7. Service-process knobs (read by src/service/app.py, not by Settings)
# ===========================================================================
# Size of the in-process job pool. Default 2. Every job runs in this pool and
# writes its state to $PVC_WORKDIR/jobs.sqlite3, so this number -- not the HTTP
# timeout -- is what limits concurrency on a free tier. Raise only with the RAM
# to back it (chunked summarising is network-bound, so 2 is usually enough).
PVC_WORKERS=2
# 1 (default) builds the ASGI app at import time, which is what
# `uvicorn service.app:app` needs. Set 0 only for tests that call the factory
# themselves; a hosted deployment with PVC_AUTOCREATE=0 serves nothing.
PVC_AUTOCREATE=1

# ===========================================================================
# 8. CLI-side server bind + egress (verified against src/pickvedio_core and src/service, and the
#    contract list above is what the service reads through Settings)
# ===========================================================================
# Host/port used when the CLI starts a local service (PORT wins over PVC_PORT if
# both are set; the container's own entrypoint uses $PORT and binds 0.0.0.0, so
# these two only matter for `pvc` running a local server on a laptop).
PVC_HOST=127.0.0.1
PVC_PORT=8788
# 1 = skip the proxy-attempted fetch and go direct. Debugging knob for a host
# with odd egress; default empty = try the system/proxy chain first.
PVC_FORCE_DIRECT=
# Standard (non-PVC) variables the HTTP layer honours: set these on a host whose
# egress goes through a proxy, otherwise leave them alone.
#   HTTP_PROXY / HTTPS_PROXY / NO_PROXY
# Honesty note: the ASR error text mentions PVC_ASR_CHUNK_SECONDS, but no code
# reads that name -- the real variable is PVC_ASR_CHUNK_SECONDS above. Until the
# message is fixed, treat PVC_ASR_CHUNK_SECONDS as not a knob.

# ===========================================================================
# 9. Accepted aliases (config.py reads these as fallbacks; prefer the names
#    above, and never set BOTH the alias and its PVC_* primary)
# ===========================================================================
#   PVC_PROVIDER            -> PVC_LLM_PROVIDER
#   PVC_API_KEY             -> PVC_LLM_API_KEY        (also DEEPSEEK_API_KEY,
#                              OPENAI_API_KEY)
#   PVC_AUTH_TOKEN          -> PVC_API_TOKEN
#   PVC_ASR_TOKEN           -> PVC_ASR_API_KEY
#   PVC_COOKIES             -> PVC_COOKIE_FILE
#   PVC_WORK_DIR            -> PVC_WORKDIR
#   FFMPEG_PATH             -> PVC_FFMPEG
#   PVC_CONFIG_FILE has no alias; it is read directly.
